<Window x:Class="MultiSound.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiSound.App.ViewModels"
        xmlns:conv="clr-namespace:MultiSound.App.Converters"
        Title="MultiSound" Width="580" Height="860" MinWidth="460" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="pack://application:,,,/Assets/multisound.ico"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <conv:StatusKindToBrushConverter x:Key="StatusBrush" />
        <conv:BoolToVisibilityConverter x:Key="Vis" />
        <conv:BoolToVisibilityConverter x:Key="InvVis" Invert="True" />

        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LinkToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="arrow" Text="▸" Foreground="{TemplateBinding Foreground}" Margin="0,0,6,0" />
                            <ContentPresenter />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="arrow" Property="Text" Value="▾" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DeviceTemplate" DataType="{x:Type vm:DeviceViewModel}">
            <Border x:Name="card" Background="{StaticResource Surface2}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                    BorderThickness="1" BorderBrush="Transparent">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                  ToolTip="Enviar o áudio para este dispositivo">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" MaxWidth="290" />
                                    <Border Style="{StaticResource Tag}" Visibility="{Binding IsBluetooth, Converter={StaticResource Vis}}">
                                        <TextBlock Text="Bluetooth" FontSize="10.5" Foreground="{StaticResource Accent}" />
                                    </Border>
                                    <Border Style="{StaticResource Tag}" Visibility="{Binding IsWindowsDefault, Converter={StaticResource Vis}}"
                                            ToolTip="Saída padrão do Windows (onde os apps tocam)">
                                        <TextBlock Text="Padrão" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                    </Border>
                                    <Border Style="{StaticResource Tag}" Visibility="{Binding IsHandsFree, Converter={StaticResource Vis}}">
                                        <TextBlock Text="Viva-voz" FontSize="10.5" Foreground="{StaticResource Warn}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Format}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0"
                                           Visibility="{Binding Format, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}"
                                       FontSize="12" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="30,6,0,0"
                               Visibility="{Binding Detail, Converter={StaticResource Vis}}" />

                    <!-- Controles da saída (somente quando selecionada) -->
                    <Grid Margin="30,10,0,0" Visibility="{Binding IsSelected, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Volume" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding VolumePercent}" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VolumeText}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SmallButton}" Width="54" Margin="8,0,0,0" Command="{Binding ToggleMuteCommand}"
                                    ToolTip="Silenciar só esta saída (útil para ouvir uma caixa por vez)">
                                <TextBlock x:Name="muteText" Text="Mudo" FontSize="11.5" />
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Atraso" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1000" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding DelayMs}" Margin="0,8,10,0"
                                ToolTip="Atrase a caixa que toca ANTES das outras até o som coincidir" />
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource SmallButton}" Content="−" Command="{Binding DelayMinusCommand}" ToolTip="−5 ms" />
                            <TextBox Width="56" Margin="4,0" TextAlignment="Center" VerticalContentAlignment="Center"
                                     Text="{Binding DelayText, UpdateSourceTrigger=LostFocus}" ToolTip="Atraso em milissegundos (Enter para aplicar)" />
                            <Button Style="{StaticResource SmallButton}" Content="+" Command="{Binding DelayPlusCommand}" ToolTip="+5 ms" />
                            <TextBlock Text="ms" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Stats}" Style="{StaticResource Caption}" FontSize="11" />
                            <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Value="{Binding Level, Mode=OneWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter TargetName="muteText" Property="Foreground" Value="{StaticResource Warn}" />
                    <Setter TargetName="muteText" Property="Text" Value="Mudo ✓" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="card" Property="Opacity" Value="0.6" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/Assets/multisound.png" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="MultiSound" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Reproduza seu áudio em vários dispositivos." Style="{StaticResource Caption}" FontSize="13" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel>
                <!-- Aviso -->
                <Border Background="#33FBBF24" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="10"
                        Padding="12,8" Margin="0,0,0,12" Visibility="{Binding HasNotice, Converter={StaticResource Vis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Warn}" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="✕" Command="{Binding DismissNoticeCommand}"
                                VerticalAlignment="Top" Margin="8,-2,-6,0" />
                    </Grid>
                </Border>

                <!-- Dispositivos -->
                <Grid Margin="0,0,0,0">
                    <TextBlock Text="DISPOSITIVOS DISPONÍVEIS" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-6,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Atualizar" Command="{Binding RefreshCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Configurações de som" Command="{Binding OpenSoundSettingsCommand}" />
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceTemplate}" Margin="0,0,0,8" />
                <TextBlock Text="Nenhum dispositivo de saída encontrado. Conecte as caixas Bluetooth nas configurações do Windows."
                           Style="{StaticResource Caption}" Margin="2,0,0,12"
                           Visibility="{Binding Devices.Count, Converter={StaticResource InvVis}}" />

                <!-- Origem -->
                <TextBlock Text="ORIGEM DO ÁUDIO" Style="{StaticResource SectionTitle}" Margin="2,8,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding CaptureModes}" SelectedIndex="{Binding CaptureModeIndex}" />
                        <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" Margin="0,8,0,0"
                                  DisplayMemberPath="Name" Visibility="{Binding IsLoopbackMode, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" Margin="2,10,0,0" LineHeight="17" />
                        <Grid Margin="2,12,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Origem" Style="{StaticResource Caption}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Value="{Binding SourceLevel, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{Binding CaptureInfo}" Style="{StaticResource Caption}" FontSize="11" Margin="2,6,0,0"
                                   Visibility="{Binding CaptureInfo, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>

                <!-- Teste de sincronização -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{StaticResource Warn}"
                        Visibility="{Binding IsTesting, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="Teste de sincronização" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" LineHeight="18"
                                   Text="Todas as caixas tocam um bipe por segundo (o áudio dos apps fica pausado durante o teste). 1) Posicione-se entre as caixas. 2) Se ouvir dois bipes (eco), descubra qual caixa toca primeiro — use &quot;Mudo&quot; para ouvir uma de cada vez. 3) Aumente o atraso da caixa que toca ANTES até ouvir um único bipe. Bluetooth costuma exigir de 0 a 300 ms." />
                    </StackPanel>
                </Border>

                <!-- Configurações -->
                <ToggleButton x:Name="settingsToggle" Style="{StaticResource LinkToggle}" Content="Configurações" Margin="2,4,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding IsChecked, ElementName=settingsToggle, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <CheckBox Content="Iniciar minimizado na bandeja" IsChecked="{Binding StartMinimized}" Margin="0,0,0,10" />
                        <CheckBox Content="Iniciar com o Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10" />
                        <CheckBox Content="Iniciar a reprodução automaticamente ao abrir" IsChecked="{Binding AutoStartPlayback}" Margin="0,0,0,10" />
                        <CheckBox Content="Fechar a janela mantém o app na bandeja" IsChecked="{Binding MinimizeToTrayOnClose}" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Buffer de segurança" VerticalAlignment="Center"
                                       ToolTip="Absorve variações da captura. Aumente se ouvir falhas/estalos; diminua para menos latência." />
                            <Slider Grid.Column="1" Minimum="30" Maximum="300" SmallChange="10" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding SafetyBufferMs}" />
                            <TextBlock Grid.Column="2" Text="{Binding SafetyBufferMs, StringFormat={}{0} ms}" TextAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Text="Latência por saída" VerticalAlignment="Center" Margin="0,10,0,0"
                                       ToolTip="Tamanho do buffer WASAPI de cada dispositivo. Aumente se um dispositivo falhar ou estalar." />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LatencyOptions}" SelectedItem="{Binding OutputLatencyMs}"
                                      Margin="0,10,0,0" ItemStringFormat="{}{0} ms" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Aplicar buffer agora" Command="{Binding ApplyBufferCommand}" Padding="12,6" />
                            <Button Style="{StaticResource GhostButton}" Content="Abrir pasta de registros" Command="{Binding OpenLogCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Controles + status -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PrimaryButton}" Content="INICIAR REPRODUÇÃO" Command="{Binding StartCommand}" Height="44" />
                <Button Grid.Column="2" Content="PARAR" Command="{Binding StopCommand}" Height="44" MinWidth="90" />
                <Button Grid.Column="4" Content="{Binding TestButtonText}" Height="44" Command="{Binding ToggleTestCommand}"
                        ToolTip="Toca um bipe por segundo em todas as caixas para ajustar os atrasos (disponível durante a reprodução)">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="12,9" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
