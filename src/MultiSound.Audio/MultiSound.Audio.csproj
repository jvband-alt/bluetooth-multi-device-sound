<Project Sdk="Microsoft.NET.Sdk">
  <!-- Integração com WASAPI (captura loopback e saídas por dispositivo). Somente Windows. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>MultiSound.Audio</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MultiSound.Core\MultiSound.Core.csproj" />
  </ItemGroup>
</Project>
